# Main restaurant database used by the Node.js application and Prisma.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurant_db
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgres_password

# Prisma CLI/runtime configuration. Replace with the same restaurant database URL.
DATABASE_URL=postgresql://postgres:replace_with_your_postgres_password@localhost:5432/restaurant_db?schema=public

# Application configuration.
SESSION_SECRET=replace_with_a_long_random_secret
PORT=3000
NODE_ENV=development

# Manufacturer is intentionally a separate database required by the CA2 setup guide.
# Restore manufacturer_restore.sql into a database named manufacturer; do not point DB_NAME at it.
